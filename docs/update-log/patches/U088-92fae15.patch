diff --git a/src/admin/data/userJourney.test.ts b/src/admin/data/userJourney.test.ts
new file mode 100644
index 0000000..3b31608
--- /dev/null
+++ b/src/admin/data/userJourney.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest'
+import { INITIAL_JOURNEY, JourneyMapSchema, addItem, counts, parseImport, removeItem, updateItem, updateStage } from './userJourney'
+
+describe('user journey map', () => {
+  it('starts with four stages, ten moments and three screens', () => {
+    expect(JourneyMapSchema.safeParse(INITIAL_JOURNEY).success).toBe(true)
+    expect(counts(INITIAL_JOURNEY)).toEqual({ stages: 4, moments: 10, screens: 3 })
+  })
+
+  it('adds, edits and removes an item without touching other stages', () => {
+    let map = addItem(INITIAL_JOURNEY, 'share', 'screens', 'x1')
+    expect(counts(map).screens).toBe(4)
+    const added = map.stages[3].screens[0]
+    map = updateItem(map, 'share', 'screens', { ...added, title: 'Recap card' })
+    expect(map.stages[3].screens[0].title).toBe('Recap card')
+    expect(map.stages[0]).toBe(INITIAL_JOURNEY.stages[0])
+    map = removeItem(map, 'share', 'screens', 'x1')
+    expect(counts(map).screens).toBe(3)
+  })
+
+  it('keeps a stage title when the new one is blank', () => {
+    const map = updateStage(INITIAL_JOURNEY, 'reflect', { title: '  ', question: 'When?' })
+    expect(map.stages[0].title).toBe('Reflect')
+    expect(map.stages[0].question).toBe('When?')
+  })
+
+  it('imports its own export and the original blueprint format', () => {
+    expect(parseImport(JSON.stringify(INITIAL_JOURNEY))).toEqual(INITIAL_JOURNEY)
+    const legacy = {
+      version: 2,
+      stages: [{ id: 'reflect', title: 'Reflect', question: 'Q', color: '#000', scenes: [{ id: 'r1', title: 'A', image: 'assets/scene-01.webp' }], screens: [] }],
+    }
+    const map = parseImport(JSON.stringify(legacy))
+    expect(map?.stages[0].moments[0]).toEqual({ id: 'r1', title: 'A', description: '', feature: '', image: '/admin/user-journey/scene-01.webp' })
+    expect(parseImport('{"stages": []}')).toBeNull()
+    expect(parseImport('not json')).toBeNull()
+  })
+})
diff --git a/src/admin/data/userJourney.ts b/src/admin/data/userJourney.ts
new file mode 100644
index 0000000..7765fb5
--- /dev/null
+++ b/src/admin/data/userJourney.ts
@@ -0,0 +1,182 @@
+import { z } from 'zod'
+
+// The user journey map (U088): the product team's blueprint of when people
+// reach for Aurelia, in four stages, each with illustrated moments and the
+// product screens that serve them. Ported from the "Aurelia journey
+// blueprint" HTML the owner supplied; edits stay in this browser, like every
+// other admin edit, until a backend exists.
+
+const IMG = '/admin/user-journey'
+
+export const JourneyItemSchema = z.object({
+  id: z.string(),
+  title: z.string(),
+  description: z.string(),
+  /** The feature opportunity the moment or screen suggests. */
+  feature: z.string(),
+  /** A path under public/ or a data: URL for an uploaded image. Empty = none. */
+  image: z.string(),
+})
+
+export const JourneyStageSchema = z.object({
+  id: z.string(),
+  title: z.string(),
+  /** The question the stage answers, e.g. "When do users pause and check in?" */
+  question: z.string(),
+  color: z.string(),
+  moments: z.array(JourneyItemSchema),
+  screens: z.array(JourneyItemSchema),
+})
+
+export const JourneyMapSchema = z.object({
+  version: z.literal(1),
+  stages: z.array(JourneyStageSchema).min(1),
+})
+
+export type JourneyItem = z.infer<typeof JourneyItemSchema>
+export type JourneyStage = z.infer<typeof JourneyStageSchema>
+export type JourneyMap = z.infer<typeof JourneyMapSchema>
+export type ItemKind = 'moments' | 'screens'
+
+export const STORAGE_KEY = 'aurelia.admin.userJourney'
+export const NEW_MOMENT_IMAGE = `${IMG}/scene-12.webp`
+
+export const INITIAL_JOURNEY: JourneyMap = {
+  version: 1,
+  stages: [
+    {
+      id: 'reflect',
+      title: 'Reflect',
+      question: 'When do users pause and check in?',
+      color: '#8eaa9b',
+      moments: [
+        { id: 'r1', title: 'Morning check-in', description: 'Start the day with a lightweight emotional pulse check and a simple recommendation based on mood, energy, or intent.', feature: 'Mood check-in + personalized daily recommendation', image: `${IMG}/scene-01.webp` },
+        { id: 'r2', title: 'In-the-moment conversation', description: 'Reach for support during the day through a conversational flow that helps users name what they feel and respond in context.', feature: 'AI chat support + emotional labeling', image: `${IMG}/scene-02.webp` },
+      ],
+      screens: [{ id: 's1', title: 'Reflection / check-in', description: 'The daily check-in: how you feel today, whether the last session helped, an optional note.', feature: 'Check-in, journaling, and adaptive guidance', image: `${IMG}/screen-3.webp` }],
+    },
+    {
+      id: 'create',
+      title: 'Create',
+      question: 'When do users express, capture, or make meaning?',
+      color: '#e4b77a',
