+export type DropLabel = 'test' | 'measured' | 'judgement' | 'not tested'
+
+export interface JourneyStep {
+  id: string
+  title: string
+  /** What the person sees at this step. */
+  sees: string
+  /** Where people drop off here; `label` says what kind of number it is. */
