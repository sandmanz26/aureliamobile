+export const MEDIA: Media[] = ['script', 'voice', 'music', 'image', 'video']
+export const MEDIA_LABEL: Record<Media, string> = { script: 'Script (LLM)', voice: 'Voice (TTS)', music: 'Music', image: 'Image', video: 'Video' }
