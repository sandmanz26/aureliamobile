diff --git a/src/api/annotations.ts b/src/api/annotations.ts
new file mode 100644
index 0000000..8e3dff0
--- /dev/null
+++ b/src/api/annotations.ts
@@ -0,0 +1,45 @@
+import { z } from 'zod'
+import { requestJson } from '../lib/http'
+
+/**
+ * /api/annotations — review pins (see api/annotations.ts and
+ * src/demo/annotations). Validated on the way in: the endpoint is
+ * unauthenticated, so what it returns is treated as untrusted input and a
+ * malformed note is dropped rather than rendered.
+ */
+export const annotation = z.object({
+  id: z.string().min(1).max(64),
+  page: z.string().max(300),
+  x: z.number(),
+  y: z.number(),
+  vw: z.number(),
+  vh: z.number(),
+  scrollY: z.number().catch(0),
+  ui: z.number().catch(1),
+  text: z.string().max(4000),
+  createdAt: z.string(),
+  updatedAt: z.string(),
+})
+
+const response = z.object({
+  configured: z.boolean(),
+  scope: z.string().optional(),
+  annotations: z.array(z.unknown()).nullable().optional(),
+})
+
+/** Keeps every valid note and drops the rest, so one bad entry cannot hide the others. */
+export function validAnnotations(list: unknown[]) {
+  return list.flatMap((item) => {
+    const parsed = annotation.safeParse(item)
+    return parsed.success ? [parsed.data] : []
+  })
+}
+
+export async function fetchAnnotations(signal?: AbortSignal) {
+  const data = await requestJson('/api/annotations', { schema: response, signal })
+  return { configured: data.configured, scope: data.scope, annotations: validAnnotations(data.annotations ?? []) }
+}
+
+export function saveAnnotations(list: z.infer<typeof annotation>[]) {
+  return requestJson('/api/annotations', { schema: response, method: 'POST', body: { annotations: list } })
+}
diff --git a/src/api/clicks.ts b/src/api/clicks.ts
new file mode 100644
index 0000000..7aa394e
--- /dev/null
+++ b/src/api/clicks.ts
@@ -0,0 +1,73 @@
+import { z } from 'zod'
+import { requestJson } from '../lib/http'
+
+/**
+ * /api/clicks — click insights (see api/clicks.ts and src/demo/insights).
+ * One schema for an event, shared by the tracker that writes them and the
+ * insights page that reads them back.
+ */
+export const clickEvent = z.object({
+  type: z.enum(['click', 'view']),
+  t: z.string(),
+  sid: z.string(),
+  page: z.string(),
+  /** Design version on screen (staging v1–v4 switcher; 2 on production). */
+  ui: z.number(),
+  vw: z.number(),
+  vh: z.number(),
+  x: z.number().optional(),
+  y: z.number().optional(),
+  docH: z.number().optional(),
+  label: z.string().optional(),
+  tag: z.string().optional(),
+  href: z.string().optional(),
+  from: z.string().optional(),
+  kind: z.string().optional(),
+  section: z.string().optional(),
+  sel: z.string().optional(),
+  ex: z.number().optional(),
+  ey: z.number().optional(),
+  ew: z.number().optional(),
+  eh: z.number().optional(),
+  state: z.string().optional(),
+  ms: z.number().optional(),
+  sy: z.number().optional(),
+  rage: z.boolean().optional(),
+  dead: z.boolean().optional(),
+  fx: z.enum(['navigated', 'changed', 'nothing']).optional(),
+  to: z.string().optional(),
+})
+export type ClickEvent = z.infer<typeof clickEvent>
+
+const readResponse = z.object({
+  configured: z.boolean(),
+  scope: z.string().optional(),
+  // Lenient on read: one malformed stored line must not hide the rest.
+  events: z.array(z.unknown()).nullable(),
+})
+
+const writeResponse = z.object({
+  configured: z.boolean(),
+  scope: z.string().optional(),
+  stored: z.number().optional(),
+  cleared: z.boolean().optional(),
+})
+
+export const clickKeys = { all: ['clicks'] as const }
+
+export async function fetchClicks(signal?: AbortSignal) {
+  const data = await requestJson('/api/clicks', { schema: readResponse, signal, timeoutMs: 20_000 })
+  const events = (data.events ?? []).flatMap((e) => {
+    const parsed = clickEvent.safeParse(e)
+    return parsed.success ? [parsed.data] : []
+  })
+  return { configured: data.configured, scope: data.scope, events }
+}
+
+export function postClicks(events: ClickEvent[]) {
+  return requestJson('/api/clicks', { schema: writeResponse, method: 'POST', body: { events }, keepalive: true })
+}
+
+export function clearClicks() {
+  return requestJson('/api/clicks', { schema: writeResponse, method: 'POST', body: { clear: true } })
+}
diff --git a/src/api/config.ts b/src/api/config.ts
new file mode 100644
index 0000000..8c5ef9e
--- /dev/null
+++ b/src/api/config.ts
@@ -0,0 +1,28 @@
+import { z } from 'zod'
+import { requestJson } from '../lib/http'
+
+/**
+ * /api/config — the published feature-flag set (see api/config.ts).
+ * Schemas mirror the endpoint; the server validates what it accepts, the
+ * client validates what it receives.
+ */
+const flags = z.record(z.string(), z.boolean())
+
+export const configResponse = z.object({
+  configured: z.boolean(),
+  flags: flags.nullable(),
+  scope: z.string().optional(),
+  environment: z.string().optional(),
+  savedAt: z.string().optional(),
+})
+export type ConfigResponse = z.infer<typeof configResponse>
+
+export const configKeys = { all: ['config'] as const }
+
+export function fetchConfig(signal?: AbortSignal) {
+  return requestJson('/api/config', { schema: configResponse, signal })
+}
+
+export function publishConfig(next: Record<string, boolean>) {
+  return requestJson('/api/config', { schema: configResponse, method: 'POST', body: { flags: next } })
+}
