+  const terms: [V9Objection, number][] = [
+    ['trust', doubt],
+    ['price', priceLoad],
+    ['time', time],
+    ['language', lang],
+    ['fit', 0.25 * (1 - fit)],
+    ['style', putOff],
+  ]
+  const objection = terms.sort((x, y) => y[1] - x[1])[0][0]
