+export const BUYER_INSTRUCTIONS_V3 = `You are a buyer test agent. This run is an A/B test on 36 personas from persona generator 2.
+
+Read first, and treat as evidence:
+- The Insight Timer research for Eugene (wiki Research, v2): day-30 retention in mental-health apps is about 3–5% of installs (median 3.3%, Baumel 2019); health and fitness trials convert at a median of about 40%; people leave over prompts before listening, paywalled basics, streaks and nagging; they stay for a quiet path that plays at once.
+- The 2025 documents (wiki Backend (old) and Artefact): the script judge's rules (pacing, pauses, breathing safety), the edit modes, feedback attribution, and the lessons: claims must match what is built, safety comes first, model scores are signals not measurements, rules beat personas.
+- Buyer agent v2: what it found and where it was too generous or too harsh.
+
+For each persona:
+1. Become them, as in v2: their money in their currency, their language, phone and data plan, sleep, what is wearing them down.
+2. Offer A is Aurelia today (as in v2). Answer only: tries, pays, and why in one line.
+3. Offer B is the proposal (listed on the page). B's items are proposals, not built; answer as if they were true on the store page and first screen. Answer in full: tries, pays, plan, four price answers (USD a month), main objection and theme, what would flip it, confidence, week-one sessions, day 30, reasoning, a quote, the three test cases against B, and which of B's changes moved them.
+4. Say if the persona does not hold together.
+
+Calibration rules (v2's, plus):
+- Look for the no first. "Free only" means pays no, unless pain is 8+ and a named trigger is met.
+- Honest disclosure stays: B still says AI writes the words. A distrustful persona does not change because the word moved.
+- Still using at day 30 must stay close to the evidence: a yes is rare (under 1 in 8), even on B.
+- A change counts as "moved them" only if their answer is different because of it.`
+
+const sc = (id: string, outcome: Outcome, note: string) => ({ id, outcome, note })
+
+function a(
+  personaId: string,
+  control: [Verdict, Verdict, string],
+  tries: Verdict,
+  pays: Verdict,
+  plan: BuyerAnswer['plan'],
+  [tooCheap, bargain, expensive, tooExpensive]: [number, number, number, number],
+  theme: Theme,
+  objection: string,
+  flip: string,
+  confidence: BuyerAnswer['confidence'],
+  week: number,
+  day30: Verdict,
+  movedBy: V3Change[],
+  reasoning: string,
+  quote: string,
+  scenarios: BuyerAnswer['scenarios'],
+  personaIssue?: string,
+): BuyerAnswer {
+  return {
+    personaId,
+    control: { tries: control[0], pays: control[1], why: control[2] },
+    tries,
+    pays,
+    plan,
+    prices: { tooCheap, bargain, expensive, tooExpensive },
+    theme,
+    objection,
+    flip,
+    confidence,
+    week,
+    day30,
+    movedBy,
+    reasoning,
+    quote,
+    scenarios,
+    personaIssue,
+  }
+}
