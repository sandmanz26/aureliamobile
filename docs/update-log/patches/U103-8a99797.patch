+import type { BuyerAnswer, BuyerRun, Outcome, Theme, Verdict } from './buyerRuns'
+
+/**
+ * Buyer agent run v3 (U103, J135): the first run on the fixed persona
+ * generator (2), and the first A/B run. Each persona answers today's offer
+ * (A, kept short) and a proposed offer (B, answered in full) built from the
+ * documents Eugene supplied and the research done for him. The agent also
+ * calibrates against the figures in those documents.
+ */
+
+/** The changes in offer B, each traced to where it comes from. */
+export const V3_CHANGES = {
+  'outcome-pitch': { label: 'Outcome first, AI explained', source: 'Insight Timer research: “No AI” is sold as a virtue; v2: distrust costs a fifth of the panel' },
+  'no-account': { label: 'First session without an account', source: 'Insight Timer research, “Now”: start without an account; 65 of 168 bad reviews are about prompts before listening' },
+  language: { label: 'Sessions in eight languages', source: 'v2: language was the largest single loss' },
+  'voice-control': { label: 'Choose the voice and how much it talks', source: 'Insight Timer research: people choose by voice, pacing and how much the guide talks; 2025 judge rubric: pacing and pauses' },
+  'data-line': { label: 'A plain data line before typing', source: 'Artefact, lesson 1 (claims match what is built); v2: privacy deal breakers' },
+  'local-price': { label: 'Local prices in seven more countries', source: 'v2: 10 of 14 without a local price found $9.99 too expensive' },
+  'yearly-first': { label: 'Yearly plan first ($59.99)', source: 'Insight Timer research: $59.99 a year; v1: the yearly plan is what lands' },
+  'offline-free': { label: 'One offline session on Free', source: 'v2: patchy data and layovers' },
+  'one-reminder': { label: 'At most one reminder, no streaks', source: 'Insight Timer research: streak and commit screens are a top leave reason (27 of 168)' },
+  'care-link': { label: 'Care after a low check-in', source: 'Artefact, lesson 3: safety is part of the first version' },
+} as const
+export type V3Change = keyof typeof V3_CHANGES
+
