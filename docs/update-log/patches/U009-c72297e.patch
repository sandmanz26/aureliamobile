 }
+
+/* ---- Version 2: coin-flip profile picture (src/versions/CoinFlip.tsx) --- */
+.v2-coin {
+  perspective: 600px;
+}
+.v2-coin-inner {
+  position: relative;
+  display: block;
+  width: 100%;
+  height: 100%;
+  transform-style: preserve-3d;
+}
+.v2-coin-face {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 9999px;
+  backface-visibility: hidden;
+}
+.v2-coin-back {
+  transform: rotateY(180deg);
+  background: radial-gradient(circle at 35% 30%, #fff1db, #ffd166 45%, #ff881b 100%);
+  box-shadow: inset 0 0 0 3px rgb(255 255 255 / 0.55), 0 6px 18px -6px rgb(255 136 27 / 0.6);
+}
+/* Arrival: a fast spin that slows and settles face-up, with a little hop. */
+@keyframes v2-coin-arrive {
+  0% { transform: rotateY(0) translateY(0); }
+  40% { transform: rotateY(900deg) translateY(-10px); }
+  100% { transform: rotateY(1080deg) translateY(0); }
+}
+/* Tap / hover: over to the coin face, hold, and back. */
+@keyframes v2-coin-flip {
+  0% { transform: rotateY(0) scale(1); }
+  30% { transform: rotateY(180deg) scale(1.06); }
+  70% { transform: rotateY(180deg) scale(1.06); }
+  100% { transform: rotateY(360deg) scale(1); }
+}
+.v2-coin-arrive {
+  animation: v2-coin-arrive 1400ms cubic-bezier(0.2, 0.7, 0.2, 1) 250ms both;
+}
+.v2-coin-flip {
+  animation: v2-coin-flip 1600ms var(--ease-in-out) both;
+}
+
+/* ---- Version 2: promo banner glow, stronger ----------------------------- */
+@keyframes v2-glow-roam {
+  0%, 100% { opacity: calc(var(--glow-opacity, 0.4) + 0.05); transform: translate(0, 0) scale(1); }
+  33% { opacity: calc(var(--glow-opacity, 0.4) + 0.35); transform: translate(18%, -14%) scale(1.25); }
+  66% { opacity: calc(var(--glow-opacity, 0.4) + 0.15); transform: translate(-12%, 10%) scale(0.9); }
+}
+:root[data-ui-version='2'] .u-glow-drift {
+  animation-name: v2-glow-roam;
+}
diff --git a/src/versions/CoinFlip.tsx b/src/versions/CoinFlip.tsx
new file mode 100644
index 0000000..47b5a78
--- /dev/null
+++ b/src/versions/CoinFlip.tsx
@@ -0,0 +1,45 @@
+import { useRef, useState } from 'react'
+import type { ReactNode } from 'react'
+import coinIcon from '../assets/coin-icon.png'
+import { useUiVersion } from './useUiVersion'
+
+/**
+ * Version 2: a profile picture that behaves like a coin — it spins in on
+ * arrival, and flips to a gold coin face and back when tapped or hovered.
+ * In v1 it renders the picture alone, with no wrapper.
+ */
+export function CoinFlip({ size, children }: { size: number; children: ReactNode }) {
+  const v2 = useUiVersion() >= 2
+  const [spins, setSpins] = useState(0)
+  // One flip at a time. Remounting the face under the pointer makes React
+  // report a fresh mouseenter, which without this guard restarts it forever.
+  const busy = useRef(false)
+  if (!v2) return <>{children}</>
+  const flip = () => {
+    if (busy.current) return
+    busy.current = true
+    setSpins((n) => n + 1)
+  }
+
+  return (
+    <button
+      type="button"
+      aria-label="Flip"
+      onClick={flip}
+      onMouseEnter={flip}
+      className="v2-coin shrink-0 rounded-full"
+      style={{ width: size, height: size }}
+    >
+      <span
+        key={spins}
+        onAnimationEnd={() => (busy.current = false)}
+        className={`v2-coin-inner ${spins ? 'v2-coin-flip' : 'v2-coin-arrive'}`}
+      >
+        <span className="v2-coin-face">{children}</span>
+        <span className="v2-coin-face v2-coin-back">
+          <img src={coinIcon} alt="" style={{ width: size * 0.62, height: size * 0.62 }} />
+        </span>
+      </span>
+    </button>
+  )
+}
