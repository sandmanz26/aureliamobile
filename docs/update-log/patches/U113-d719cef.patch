+          </p>
+        </Panel>
+
+        <Panel title="Pilot gates" description="The five numbers set in advance in the plan. Each miss points to a different fix." actions={<Badge tone={passed === 5 ? 'good' : passed >= 3 ? 'warning' : 'critical'}>{passed} of 5 pass</Badge>}>
