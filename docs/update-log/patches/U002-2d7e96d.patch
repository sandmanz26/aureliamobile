diff --git a/src/styles/versions.css b/src/styles/versions.css
index 0e3283a..bde5f1c 100644
--- a/src/styles/versions.css
+++ b/src/styles/versions.css
@@ -104,3 +104,52 @@
 :root[data-ui-version='2'] .u-stagger > * {
   animation-duration: var(--motion-slow);
 }
+
+/* Feature-card icons: one micro-animation per meaning, looping gently and
+   offset so the grid never moves in unison. The tile breathes a little on
+   desktop hover. */
+@keyframes v2-icon-rise {
+  0%, 60%, 100% { transform: translate(0, 0); }
+  30% { transform: translate(2px, -3px); }
+}
+@keyframes v2-icon-wave {
+  0%, 100% { transform: translateX(0); }
+  50% { transform: translateX(3px); }
+}
+@keyframes v2-icon-beat {
+  0%, 40%, 100% { transform: scale(1) rotate(0); }
+  15% { transform: scale(1.15) rotate(-8deg); }
+  28% { transform: scale(0.96) rotate(4deg); }
+}
+@keyframes v2-icon-breeze {
+  0%, 100% { transform: translateX(0); opacity: 1; }
+  45% { transform: translateX(4px); opacity: 0.55; }
+  50% { transform: translateX(-4px); opacity: 0.55; }
+}
+@keyframes v2-icon-flip {
+  0%, 55%, 100% { transform: rotateY(0); }
+  75% { transform: rotateY(180deg); }
+}
+@keyframes v2-icon-gather {
+  0%, 60%, 100% { transform: scale(1); }
+  20% { transform: scale(0.88); }
+  40% { transform: scale(1.08); }
+}
+:root[data-ui-version='2'] .u-feature-icon {
+  transition: transform var(--motion-base) var(--ease-spring), box-shadow var(--motion-base) var(--ease-out);
+}
+:root[data-ui-version='2'] .u-feature-icon > svg {
+  animation: 2.8s var(--ease-in-out) infinite both;
+}
+:root[data-ui-version='2'] .u-feature-icon[data-motion='rise'] > svg { animation-name: v2-icon-rise; }
+:root[data-ui-version='2'] .u-feature-icon[data-motion='wave'] > svg { animation-name: v2-icon-wave; animation-delay: 0.3s; }
+:root[data-ui-version='2'] .u-feature-icon[data-motion='beat'] > svg { animation-name: v2-icon-beat; animation-delay: 0.6s; }
+:root[data-ui-version='2'] .u-feature-icon[data-motion='breeze'] > svg { animation-name: v2-icon-breeze; animation-duration: 3.4s; animation-delay: 0.9s; }
+:root[data-ui-version='2'] .u-feature-icon[data-motion='flip'] > svg { animation-name: v2-icon-flip; animation-duration: 3.6s; animation-delay: 1.2s; }
+:root[data-ui-version='2'] .u-feature-icon[data-motion='gather'] > svg { animation-name: v2-icon-gather; animation-delay: 1.5s; }
+@media (hover: hover) {
+  :root[data-ui-version='2'] div:hover > .u-feature-icon {
+    transform: scale(1.08) rotate(-4deg);
+    box-shadow: 0 8px 18px -8px rgb(255 136 27 / 0.55);
+  }
+}
