diff --git a/src/guides/GuidePage.tsx b/src/guides/GuidePage.tsx
new file mode 100644
index 0000000..f4d3590
--- /dev/null
+++ b/src/guides/GuidePage.tsx
@@ -0,0 +1,260 @@
+import { ArrowLeft, BookOpen, FileText, Search, Server, X } from 'lucide-react'
+import { marked } from 'marked'
+import { useEffect, useMemo, useRef, useState, type MouseEvent } from 'react'
+import { Link, Navigate, useNavigate, useParams } from 'react-router-dom'
+import { BUILD } from '../lib/build'
+import adminGuideline from './content/admin-guideline.html?raw'
+import prdOverview from '../../docs/PRD-OVERVIEW.md?raw'
+import apiContract from '../../docs/api/API-CONTRACT.md?raw'
+import { filterToc, prepareDoc } from './prepareDoc'
+import './guides.css'
+
+/**
+ * /guide — the team's documents, readable on any site (production included)
+ * behind the same site password as the app. One shell, three documents:
+ * the admin guideline (generated by scripts/guides/admin_guideline.py) and
+ * two Markdown files rendered as they stand in docs/, so the page can never
+ * drift from the file it shows.
+ */
+const DOCS = [
+  {
+    id: 'admin',
+    title: 'Admin guideline',
+    blurb: 'Every admin module: purpose, what you see, what you can do, rules, permissions, and what the backend replaces.',
+    icon: BookOpen,
+    source: 'scripts/guides/admin_guideline.py',
+    html: () => adminGuideline,
+  },
+  {
+    id: 'prd',
+    title: 'Product requirements',
+    blurb: 'What Aurelia is, who it is for, what is built and what is not, how success is measured, and the open decisions.',
+    icon: FileText,
+    source: 'docs/PRD-OVERVIEW.md',
+    html: () => marked.parse(prdOverview, { async: false }),
+  },
+  {
+    id: 'api',
+    title: 'API contract',
+    blurb: 'The backend plan for production: conventions, data model, every endpoint, the AI system, phasing and decisions.',
+    icon: Server,
+    source: 'docs/api/API-CONTRACT.md',
+    html: () => marked.parse(apiContract, { async: false }),
+  },
+] as const
+
+type DocId = (typeof DOCS)[number]['id']
+
+function DocTabs({ current }: { current?: DocId }) {
+  return (
+    <nav className="gd-tabs" aria-label="Documents">
+      {DOCS.map((d) => (
+        <Link key={d.id} to={`/guide/${d.id}`} aria-current={d.id === current ? 'page' : undefined}>
+          {d.title}
+        </Link>
+      ))}
+    </nav>
+  )
+}
+
+function TopBar({ current }: { current?: DocId }) {
+  return (
+    <header className="gd-top">
+      <Link to="/guide" className="gd-brand">
+        <span aria-hidden="true" className="gd-mark" />
+        Aurelia docs
+      </Link>
+      <DocTabs current={current} />
+      <Link to="/admin" className="gd-back">
+        <ArrowLeft size={14} aria-hidden="true" /> Admin
+      </Link>
+    </header>
+  )
+}
+
+export function GuideIndexPage() {
+  return (
+    <div className="gd">
+      <TopBar />
+      <main className="gd-index">
+        <p className="gd-eyebrow">Aurelia · team documents</p>
+        <h1>Read the product, the admin and the backend plan</h1>
+        <p className="gd-lede">
+          Three documents, kept in the repository and shown here as they stand. Every figure in the app is sample data
+          until the backend exists.
+        </p>
+        <div className="gd-cards">
+          {DOCS.map((d) => (
+            <Link key={d.id} to={`/guide/${d.id}`} className="gd-card">
+              <d.icon size={20} aria-hidden="true" />
+              <b>{d.title}</b>
+              <span>{d.blurb}</span>
+            </Link>
+          ))}
+        </div>
+        <p className="gd-foot">
+          {BUILD.label} · {BUILD.version} · {BUILD.commit}
+        </p>
+      </main>
+    </div>
+  )
+}
+
+export function GuidePage() {
+  const { doc: docParam } = useParams()
+  const meta = DOCS.find((d) => d.id === docParam)
+  if (!meta) return <Navigate to="/guide" replace />
+  return <GuideDoc key={meta.id} meta={meta} />
+}
+
+function GuideDoc({ meta }: { meta: (typeof DOCS)[number] }) {
+  const navigate = useNavigate()
+  const prepared = useMemo(() => prepareDoc(meta.html()), [meta])
+  const [query, setQuery] = useState('')
+  // Below lg the contents list folds away above the document.
+  const [tocOpen, setTocOpen] = useState(false)
+  const [active, setActive] = useState<string | null>(null)
+  const [shot, setShot] = useState<{ src: string; caption: string } | null>(null)
+  const content = useRef<HTMLDivElement>(null)
+  const viewer = useRef<HTMLDialogElement>(null)
+  const toc = useMemo(() => filterToc(prepared.toc, query), [prepared, query])
+
+  useEffect(() => {
+    document.title = `${meta.title} · Aurelia`
+  }, [meta])
+
+  // Open on the section in the address, as a shared link expects.
+  useEffect(() => {
+    const id = decodeURIComponent(window.location.hash.slice(1))
+    if (id) document.getElementById(id)?.scrollIntoView()
+    else window.scrollTo(0, 0)
+  }, [prepared])
+
+  // The admin guideline's module cards hide when a search does not match
+  // them; the Markdown documents keep their text and filter the contents only.
+  useEffect(() => {
+    const root = content.current
+    if (!root) return
+    const q = query.trim().toLowerCase()
+    root.querySelectorAll<HTMLElement>('section.mod').forEach((s) => {
+      s.hidden = q !== '' && !(s.textContent ?? '').toLowerCase().includes(q)
+    })
+  }, [query, prepared])
+
+  useEffect(() => {
+    const root = content.current
+    if (!root || !('IntersectionObserver' in window)) return
+    const io = new IntersectionObserver(
+      (entries) => {
+        const hit = entries.find((e) => e.isIntersecting)
+        if (hit) setActive(hit.target.id)
+      },
+      { rootMargin: '-15% 0px -75% 0px' },
+    )
+    prepared.toc.forEach((e) => {
+      const el = document.getElementById(e.id)
+      if (el) io.observe(el)
+    })
+    return () => io.disconnect()
+  }, [prepared])
+
+  useEffect(() => {
+    const d = viewer.current
+    if (!d) return
+    if (shot && !d.open) d.showModal()
+    if (!shot && d.open) d.close()
+  }, [shot])
+
+  function jump(id: string) {
+    const el = document.getElementById(id)
+    if (!el) return
+    el.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
+    window.history.replaceState(window.history.state, '', `#${id}`)
+  }
+
+  function onContentClick(e: MouseEvent<HTMLDivElement>) {
+    const target = e.target as HTMLElement
+    const button = target.closest<HTMLElement>('.shot')
+    if (button) {
+      setShot({ src: button.dataset.full ?? '', caption: button.dataset.cap ?? '' })
+      return
+    }
+    const a = target.closest('a')
+    const href = a?.getAttribute('href')
+    if (!a || !href) return
+    if (href.startsWith('#')) {
+      e.preventDefault()
+      jump(href.slice(1))
+    } else if (href.startsWith('/guide')) {
+      e.preventDefault()
+      navigate(href)
+    }
+  }
+
+  return (
+    <div className="gd">
+      <TopBar current={meta.id} />
+      <div className="gd-layout">
+        <aside className={`gd-side${tocOpen ? ' open' : ''}`} aria-label="Contents">
+          <button type="button" className="gd-toggle" aria-expanded={tocOpen} onClick={() => setTocOpen((o) => !o)}>
+            Contents and search
+          </button>
+          <label className="gd-search">
+            <Search size={14} aria-hidden="true" />
+            <input
+              type="search"
+              value={query}
+              onChange={(e) => {
+                setQuery(e.target.value)
+                setTocOpen(true)
+              }}
+              placeholder={meta.id === 'admin' ? 'Search modules, e.g. coins' : 'Search this document'}
+              aria-label="Search this document"
+            />
+          </label>
+          <ol className="gd-toc">
+            {toc.map((e) => (
+              <li key={e.id} className={e.level === 3 ? 'sub' : undefined}>
+                <a
+                  href={`#${e.id}`}
+                  aria-current={active === e.id ? 'location' : undefined}
+                  onClick={(ev) => {
+                    ev.preventDefault()
+                    setTocOpen(false)
+                    jump(e.id)
+                  }}
+                >
+                  {e.text}
+                </a>
+              </li>
+            ))}
+            {toc.length === 0 && <li className="gd-empty">Nothing matches “{query}”.</li>}
+          </ol>
+          <p className="gd-source">
+            Source: <code>{meta.source}</code>
+            <br />
+            {BUILD.label} · {BUILD.commit}
+          </p>
+        </aside>
+        <main className="gd-main">
+          <div
+            ref={content}
+            className={`gd-doc ${meta.id === 'admin' ? 'is-guideline' : 'is-markdown'}`}
+            onClick={onContentClick}
+            // Our own documents from the repository, not user input.
+            dangerouslySetInnerHTML={{ __html: prepared.html }}
+          />
+        </main>
+      </div>
+      <dialog ref={viewer} className="gd-viewer" onClose={() => setShot(null)} aria-label={shot?.caption ?? 'Screenshot'}>
+        <div className="gd-viewer-head">
+          <span>{shot?.caption}</span>
+          <button type="button" onClick={() => setShot(null)} aria-label="Close">
+            <X size={16} aria-hidden="true" />
+          </button>
+        </div>
+        {shot && <img src={shot.src} alt={shot.caption} />}
+      </dialog>
+    </div>
+  )
+}
