-/* Type, shared by every document (U082). Mulish is self-hosted at 300–600
+/* Type, shared by every document (U082). Mulish was the face until U139 (now Source Sans 3, self-hosted); it is self-hosted at 300–600
    only, so nothing here asks for 700 or 800: the browser would fake the bold
    and headings would smear. Body text is a size up from the app's (16.5px on
    desktop) with a 1.7 leading and a 68-character measure, the range that
    reads comfortably for long documents. One spacing rhythm: paragraphs and
    lists end on 1em, headings take more space above than below so each one
    belongs to the text it introduces. */
-.gd-doc { --gd-body: #3a2a1c; --gd-link: #b4530a; color: var(--gd-body); font-size: 16.5px; line-height: 1.7; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; font-variant-numeric: tabular-nums; }
+.gd-doc { --gd-body: #2f2216; --gd-link: #b4530a; color: var(--gd-body); font-size: 17.5px; line-height: 1.7; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; font-variant-numeric: tabular-nums; }
 .gd-doc h1, .gd-doc h2, .gd-doc h3, .gd-doc h4 { color: var(--gd-ink); font-weight: 600; text-wrap: balance; }
 .gd-doc h1 { font-size: clamp(30px, 4vw, 42px); line-height: 1.15; letter-spacing: -0.015em; margin: 8px 0 16px; }
 .gd-doc h2 { font-size: 26px; line-height: 1.3; letter-spacing: -0.01em; margin: 64px 0 14px; padding-top: 22px; border-top: 3px solid transparent; border-image: linear-gradient(90deg, #ff8514, #ffe270 60%, transparent) 1; }
