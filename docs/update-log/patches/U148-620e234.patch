+export const PLANNER: PlannerRow[] = [
+  { phase: 'Start', bar: 'OB001', barName: 'Introduction', element: 'E12', elementName: 'Warm Welcome', wbSeconds: 5, wbWords: 10, seconds: 20, words: 15, note: 'Soft, by name if known.' },
