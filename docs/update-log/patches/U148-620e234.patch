+describe('How a session is built (U148)', () => {
+  it('has the 16 workbook steps in order, 3 Meta, 7 Path, 6 Script', () => {
+    expect(CASCADE.map((c) => c.n)).toEqual(Array.from({ length: 16 }, (_, i) => i + 1))
