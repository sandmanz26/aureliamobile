+  const [confirming, setConfirming] = useState<string | null>(null)
+
+  function submit(ev: FormEvent) {
+    ev.preventDefault()
+    if (!note.trim()) return
+    onAdd({
+      id: `${participantId}-${Date.now()}`,
+      participantId,
+      date: day,
+      channel,
+      feeling: feeling ? Number(feeling) : null,
