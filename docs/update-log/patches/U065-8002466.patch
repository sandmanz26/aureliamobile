+.pb-glow { position: absolute; top: -90px; right: -40px; width: 300px; height: 300px; border-radius: 50%; background: #FFE682; opacity: 0.55; filter: blur(80px); pointer-events: none; }
+.pb-net { position: absolute; top: 18px; right: 0; width: 230px; height: auto; opacity: 0.95; pointer-events: none; }
+.pb-brandrow { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
+.pb-doclabel { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pb-muted); padding-left: 12px; border-left: 1px solid var(--pb-line); }
+.pb-cover h1 { margin-top: 8px; max-width: 16ch; }
