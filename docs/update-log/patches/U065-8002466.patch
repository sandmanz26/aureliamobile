+h2 { border-top: 3px solid transparent; border-image: linear-gradient(90deg, #FF8514, #FFE270 60%, transparent) 1; }
+.pb-close { display: flex; align-items: center; gap: 12px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--pb-line); }
+.pb-close p { margin: 0; font-size: 14px; color: var(--pb-muted); }
+.pb-close b { color: var(--pb-ink); }
 .pb-journey { margin-top: 22px; background: var(--pb-surface); border: 1px solid var(--pb-line); border-radius: 16px; padding: 16px 18px 12px; }
 .pb-scale { display: grid; grid-template-columns: 7fr 7fr 7fr 7fr; border-radius: 999px; overflow: hidden; font-size: 11px; font-weight: 700; text-align: center; }
